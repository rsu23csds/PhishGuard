# Copy to .env and adjust values before running.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=phishing_detector

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API
BACKEND_CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30

# Optional bootstrap admin (created only if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Optional External Reputation APIs (leave empty to use ML + local heuristics)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
